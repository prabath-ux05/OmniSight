# -----------------------------------------------------------------------------
# OmniSight Dashboard Frontend Environment Configuration
# -----------------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty to use the Vite development server proxy
# (recommended for local development: proxies /api and /health to http://127.0.0.1:8000)
#
# Or set explicitly to your OmniSight FastAPI backend URL if connecting directly:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
