# -----------------------------------------------------------------------------
# OmniSight Environment Configuration Template
# Copy this file to .env and configure with appropriate values.
# NEVER commit real credentials or .env files to version control.
# -----------------------------------------------------------------------------

# Application Settings
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Multimodal & Vision Engine Settings
VISION_MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
VISION_TIMEOUT_SECONDS=30.0


# Browser Automation & RPA Agent Settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000
SCREENSHOT_STORAGE_PATH=browser_agent/screenshots

# Self-Healing Pipeline Settings
AUTO_FIX_CONFIDENCE_THRESHOLD=0.85
MAX_HEALING_ATTEMPTS=3

# GitHub Integration Settings
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_repository_name
GITHUB_BASE_BRANCH=main
